@page "/repopulse/"
@inject SiteDataClient Data

<PageTitle>Observatory — ulfbou.github.io</PageTitle>

<h1>Observatory</h1>
<p class="muted">A quiet place to explore repositories. Full interactivity will grow here.</p>

@if (_loading)
{
    <p>Loading repositories…</p>
}
else if (_failed)
{
    <p>Repository data is temporarily unavailable.</p>
}
else if (_repos.Count == 0)
{
    <p>No repositories are available for this collection.</p>
}
else
{
    <div class="repo-grid">
        @foreach (var repo in _repos)
        {
            <RepoCard Repo="repo" />
        }
    </div>

    <h2>Graph preview</h2>
    <ObservatoryPreview />
}

@code {
    private readonly List<RepoModel> _repos = [];
    private bool _loading = true;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        var repos = await Data.GetReposAsync();
        _loading = false;

        if (repos is null)
        {
            _failed = true;
            return;
        }

        _repos.AddRange(repos);
    }
}
