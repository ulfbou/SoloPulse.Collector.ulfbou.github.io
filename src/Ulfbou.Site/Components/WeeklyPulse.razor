@using Markdig
@inject SiteDataClient Data

<section aria-labelledby="this-week">
    <h2 id="this-week">This week</h2>

    @if (_loading)
    {
        <p>Loading weekly pulse…</p>
    }
    else if (_failed)
    {
        <p>This week's pulse is temporarily unavailable. The archive is still available at <a href="/pulse/">/pulse/</a>.</p>
    }
    else if (string.IsNullOrWhiteSpace(_html))
    {
        <p>No weekly pulse is available for this period.</p>
    }
    else
    {
        @((MarkupString)_html)
    }
</section>

@code {
    private string? _html;
    private bool _loading = true;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        var now = await Data.GetNowAsync();
        var path = now?.Pulse.FriendlyMarkdown ?? "/pulse/weekly-friendly.md";
        var markdown = await Data.GetWeeklyMarkdownAsync(path);
        _loading = false;

        if (markdown is null)
        {
            _failed = true;
            return;
        }

        _html = Markdown.ToHtml(markdown);
    }
}
