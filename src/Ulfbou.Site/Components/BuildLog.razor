@inject SiteDataClient Data

<section aria-labelledby="build-log">
    <h2 id="build-log">Build log</h2>

    @if (_loading)
    {
        <p>Loading build log…</p>
    }
    else if (_failed)
    {
        <p class="muted">
            Build log is temporarily unavailable. The data file could not be
            loaded.
        </p>
    }
    else if (_items.Count == 0)
    {
        <p class="muted">
            No build activity was recorded this week. The log will repopulate
            with new commits.
        </p>
    }
    else
    {
        <ul class="build-log">
            @foreach (var item in _items)
            {
                <li>
                    <a href="@item.Href">@item.RepoLabel</a>
                    <span> — @item.Summary</span>

                    @if (!string.IsNullOrWhiteSpace(item.Detail))
                    {
                        <span class="muted"> (@item.Detail)</span>
                    }

                    <span class="meta"> [@item.Status]</span>
                </li>
            }
        </ul>
    }
</section>

@code {
    private readonly List<BuildLogItem> _items = [];
    private bool _loading = true;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        var metrics = await Data.GetMetricsAsync();
        _loading = false;

        if (metrics is null)
        {
            _failed = true;
            return;
        }

        _items.AddRange(metrics.BuildLog);
    }
}
